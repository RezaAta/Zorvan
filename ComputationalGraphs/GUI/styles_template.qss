/* Modern stylesheet template for ComputationalGraphs GUI */

QMainWindow {
    background-color: {{panel_bg}};
}

QDockWidget {
    background-color: {{panel_bg}};
    color: {{text}};
}

QDockWidget::title {
    background-color: {{header_bg}};
    padding: 6px;
    border: 1px solid {{border}};
}

QListWidget {
    background-color: {{list_bg}};
    color: {{text}};
    border: 1px solid {{border}};
    outline: none;
}

/* Node items are drawn directly by NodeItem, not via stylesheet. Use node_default in code. */

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid {{border}};
}

QListWidget::item:selected {
    background-color: {{accent}};
}

QListWidget::item:hover {
    background-color: {{accent}};
}

QPushButton {
    background-color: {{button_bg}};
    color: {{text}};
    border: 1px solid {{border}};
    padding: 6px 12px;
    border-radius: {{button_border_radius}};
}

/* Themed widgets set a property themed=true so QSS can target them explicitly */
QPushButton[themed="true"] {
    background-color: {{button_bg}};
    color: {{text}};
    border: 1px solid {{border}};
    padding: 6px 12px;
    border-radius: {{button_border_radius}};
}

QToolButton[themed="true"] {
    background-color: transparent;
    color: {{text}};
    padding: 6px 8px;
    border-radius: {{button_border_radius}};
}

/* Hover/pressed states for themed tool buttons */
QToolButton[themed="true"]:hover {
    background-color: {{button_hover}};
}
QToolButton[themed="true"]:pressed {
    background-color: {{button_pressed}};
}

/* Toolbar-scoped base + hover so toolbar buttons match the control panel's hover */
QToolBar QPushButton[themed="true"],
QToolBar QToolButton[themed="true"] {
    background-color: {{button_bg}};
    color: {{text}};
    border: 1px solid transparent;
    padding: 6px 8px;
    border-radius: {{button_border_radius}};
    min-height: 28px;
    max-height: 36px;
    margin: 6px 0;
}
QToolBar QPushButton[themed="true"]:hover,
QToolBar QToolButton[themed="true"]:hover {
    background-color: {{button_hover}};
    border: 1px solid {{accent}};
    color: {{text}};
}

QPushButton:hover {
    background-color: {{button_hover}};
}

/* More specific selector for themed push buttons to ensure hover works
   even when application style interplay would otherwise suppress it. */
QPushButton[themed="true"]:hover {
    background-color: {{button_hover}};
    border: 1px solid {{accent}};
}

QPushButton:pressed {
    background-color: {{button_pressed}};
}


QPushButton:disabled {
    background-color: {{button_disabled_bg}};
    color: {{muted_text}};
}

QLabel {
    color: {{text}};
}

QSpinBox, QDoubleSpinBox {
    background-color: {{list_bg}};
    color: {{text}};
    border: 1px solid {{border}};
    padding: 3px;
}

QSlider::groove:horizontal {
    background-color: {{list_bg}};
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: {{accent}};
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

/* Progress bar theming: ensure the filled 'chunk' uses the accent color */
QProgressBar {
    background-color: {{list_bg}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 4px;
    min-height: 12px;
}
QProgressBar::chunk {
    background-color: {{accent}};
}

/* Scroll area + panels */
QScrollArea[themed="true"] QWidget {
    background-color: {{list_bg}};
}

QScrollBar:vertical {
    background: {{list_bg}};
    width: 12px;
}

QScrollBar::handle:vertical {
    background: {{button_bg}};
    border-radius: 6px;
}

/* Add radius and subtle border to panels */
QWidget[themed_panel="true"] {
    background-color: {{panel_bg}};
    border-radius: {{panel_border_radius}};
    border: 1px solid {{panel_border}};
}

QCheckBox {
    color: {{text}};
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid {{border}};
    background-color: {{list_bg}};
}

QCheckBox::indicator:checked {
    background-color: {{accent}};
}

QStatusBar {
    background-color: {{dock_bg}};
    color: {{text}};
}

QMenuBar {
    background-color: {{header_bg}};
    color: {{text}};
}

QMenuBar::item:selected {
    background-color: {{header_bg}};
}

QMenu {
    background-color: {{header_bg}};
    color: {{text}};
    border: 1px solid {{border}};
}

QMenu::item:selected {
    background-color: {{header_bg}};
}

QToolBar {
    background-color: {{header_bg}};
    border: 1px solid {{border}};
    spacing: 3px;
}

/* Collapsible section toggles (QToolButton) - provide a subtle hover highlight */
QToolButton {
    text-align: left;
    padding: 6px 8px;
    border-radius: 6px;
    font-weight: bold;
}
QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.03);
}
QToolButton:checked {
    background-color: {{header_bg}};
    color: {{text}};
}

QGraphicsView {
    background-color: {{canvas_bg}};
    border: none;
}
