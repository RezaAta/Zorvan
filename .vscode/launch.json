{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Run GUI",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/run_gui.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    },
    {
      "name": "Python: Attach (debugpy)",
      "type": "python",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [ { "localRoot": "${workspaceFolder}", "remoteRoot": "${workspaceFolder}" } ]
    }
  ]
}
